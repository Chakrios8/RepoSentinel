# RepoSentinel Environment Configuration

# Google Gemini API Key for autonomous code review agent
# Obtain key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# LLM Model Name (e.g., gemini-flash-lite-latest, gemini-flash-latest, gemini-3.8-flash)
GEMINI_MODEL=gemini-flash-lite-latest

# API Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# ML Triage Classifier Settings
TRIAGE_THRESHOLD=0.50
MODEL_PATH=backend/ml/ast_triage_model.joblib
FEATURE_COLUMNS_PATH=backend/ml/feature_columns.json

# ChromaDB Vector Store Persistence
CHROMA_PERSIST_DIR=backend/rag/chroma_db
